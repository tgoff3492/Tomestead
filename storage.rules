// Tomestead: who can upload cover photos (Cloud Storage).
// Paste this into Firebase console → Storage → Rules, then Publish.
// (The first time, the console asks to let Storage rules check Firestore. Allow it:
// that's how the guest list is checked here.)
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function family() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/invites/$(request.auth.token.email.lower())).data.get('family', false) == true;
    }

    // covers/<your account id>/<book id>-<version>.jpg
    match /covers/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/invites/$(request.auth.token.email.lower()))
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // family/<id>.jpg: the family paintings, for readers marked family: true on the guest list.
    // Anyone in the family can see them; only the person who added one can remove it.
    match /family/{file} {
      allow read: if family();
      allow delete: if family() && resource.metadata.by == request.auth.uid;
      allow create: if family()
        && request.resource.metadata.by == request.auth.uid
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // catalog/<isbn>.jpg: a cover a reader photographed, shared with every reader through the catalog.
    // Anyone invited can see them; a new one can be added, never replaced or removed from the app.
    match /catalog/{file} {
      allow read: if request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/invites/$(request.auth.token.email.lower()));
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/invites/$(request.auth.token.email.lower()))
        && request.resource.metadata.by == request.auth.uid
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else is closed.
  }
}
