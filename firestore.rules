// Tomestead: who can read and write library data (Firestore).
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, email confirmed, and on the guest list (invites/<email, lowercase>).
    function invited() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()));
    }

    // Invited and marked family: true on their guest-list entry (shares the family paintings).
    function family() {
      return invited()
        && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.get('family', false) == true;
    }

    // The guest list. You edit it in the console; the app may only check its own entry.
    match /invites/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
    }

    // Each reader's library: only they can see or change it.
    match /users/{uid} {
      allow read, write: if invited() && request.auth.uid == uid;

      match /books/{bookId} {
        allow read, delete: if invited() && request.auth.uid == uid;
        allow create, update: if invited() && request.auth.uid == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 500;
      }
    }

    // Family paintings (Customize → Paintings): only family can see them; each person can
    // add their own and remove only their own. The picture itself is in Storage at family/<id>.jpg.
    match /familyPaintings/{id} {
      allow read: if family();
      allow create: if family()
        && request.resource.data.keys().hasOnly(['name', 'url', 'path', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.url is string && request.resource.data.url.size() <= 1000
        && request.resource.data.path == 'family/' + id + '.jpg';
      allow delete: if family() && resource.data.by == request.auth.uid;
    }

    // Feedback from inside the app (••• → Send feedback) and automatic error reports.
    // Readers can add them but never read them back; you read them in the Firebase console.
    match /feedback/{id} {
      allow create: if invited()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'at', 'kind', 'text', 'doing', 'where', 'device', 'build', 'books'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 5000;
    }
    match /errors/{id} {
      allow create: if invited()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'at', 'msg', 'src', 'stack', 'where', 'device', 'build', 'when'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 1000
        && (!('stack' in request.resource.data) || request.resource.data.stack.size() <= 3000);
    }

    // Everything else is closed.
  }
}
